{
  "name": "moscowcss-meetup-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "meetup": "31",
  "scripts": {
    "dev": "slidev open.md --open",
    "dev:close": "slidev close.md --open",
    "build": "node scripts/build.mjs",
    "export": "slidev export open.md --output open.pdf",
    "export:close": "slidev export close.md --output close.pdf",
    "qr": "node scripts/gen-qr.mjs",
    "test:qr": "node scripts/gen-qr.test.mjs"
  },
  "dependencies": {
    "@slidev/cli": "^52.16.0",
    "@slidev/theme-default": "^0.25.0",
    "qrcode": "^1.5.4"
  }
}
